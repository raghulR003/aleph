---
import { formatDate, getReadingTime } from "@/utils/posts";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  coverImage?: string;
  coverAlt?: string;
  tags?: string[];
  body?: string;
}

const { title, description, pubDate, slug, coverImage, coverAlt, tags = [], body = "" } = Astro.props;
const readingTime = getReadingTime(body);
---

<article class="relative overflow-hidden rounded-card group">
  <a href={`/blog/${slug}`} class="block">
    <!-- Cover image with gradient overlay -->
    <div class="relative aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9]">
      {
        coverImage ? (
          <img
            src={coverImage}
            alt={coverAlt || title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="eager"
          />
        ) : (
          <div class="absolute inset-0 bg-gradient-to-br from-accent/20 via-purple-500/20 to-pink-500/20 dark:from-accent-dark/30 dark:via-purple-400/20 dark:to-pink-400/20" />
        )
      }
      <!-- Gradient overlay for text readability -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"
      >
      </div>

      <!-- Content overlay -->
      <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 lg:p-8">
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-2 sm:mb-3">
              {tags.slice(0, 3).map((tag) => (
                <span class="inline-block px-2 py-0.5 text-[10px] sm:text-xs font-medium rounded-tag bg-white/20 text-white backdrop-blur-sm">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
        <h2
          class="font-heading font-extrabold text-xl sm:text-2xl lg:text-4xl leading-tight text-white mb-2 sm:mb-3 text-balance"
        >
          {title}
        </h2>
        <p class="text-xs sm:text-base text-white/80 line-clamp-2 max-w-2xl mb-2 sm:mb-3">
          {description}
        </p>
        <div class="flex items-center gap-2 sm:gap-3 text-[10px] sm:text-sm text-white/60">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span class="w-1 h-1 rounded-full bg-white/40"></span>
          <span>{readingTime}</span>
        </div>
      </div>
    </div>
  </a>
</article>

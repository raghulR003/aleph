---
interface Props {
  leftTitle: string;
  rightTitle: string;
}

const { leftTitle, rightTitle } = Astro.props;
---

<div class="my-10 grid gap-4 md:grid-cols-2">
  <section class="rounded-card border border-border dark:border-border-dark bg-surface-card dark:bg-surface-card-dark p-5">
    <h3 class="mt-0 mb-4 font-heading text-lg font-semibold text-text-primary dark:text-text-primary-dark">
      {leftTitle}
    </h3>
    <div class="comparison-panel">
      <slot name="left" />
    </div>
  </section>

  <section class="rounded-card border border-border dark:border-border-dark bg-surface-card dark:bg-surface-card-dark p-5">
    <h3 class="mt-0 mb-4 font-heading text-lg font-semibold text-text-primary dark:text-text-primary-dark">
      {rightTitle}
    </h3>
    <div class="comparison-panel">
      <slot name="right" />
    </div>
  </section>
</div>

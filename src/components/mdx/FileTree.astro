---
interface Props {
  title?: string;
}

const { title = "Project structure" } = Astro.props;
---

<section class="my-8 overflow-hidden rounded-card border border-border dark:border-border-dark bg-surface-card dark:bg-surface-card-dark">
  <div class="border-b border-border dark:border-border-dark px-4 py-3 font-ui text-sm font-semibold text-text-secondary dark:text-text-secondary-dark">
    {title}
  </div>
  <pre class="overflow-x-auto p-4 text-sm leading-7 text-text-primary dark:text-text-primary-dark"><code><slot /></code></pre>
</section>

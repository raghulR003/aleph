---
interface Props {
  siteName?: string;
}

const { siteName = "netztalt." } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/categories", label: "Categories" },
  { href: "/tags", label: "Tags" },
  { href: "/search", label: "Search" },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-border dark:border-border-dark bg-surface/80 dark:bg-surface-dark/80 backdrop-blur-lg"
>
  <div class="max-w-wide mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / Site Name -->
      <a
        href="/"
        class="flex items-center gap-2 text-xl font-heading font-bold text-text-primary dark:text-text-primary-dark hover:text-accent dark:hover:text-accent-dark transition-colors"
      >
        <span class="text-accent dark:text-accent-dark text-2xl">◊</span>
        {siteName}
      </a>

      <!-- Navigation -->
      <nav class="hidden sm:flex items-center gap-1">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "px-3 py-2 rounded-card text-sm font-medium transition-colors",
                currentPath === link.href ||
                (link.href !== "/" && currentPath.startsWith(link.href))
                  ? "text-accent dark:text-accent-dark bg-surface-card dark:bg-surface-card-dark"
                  : "text-text-secondary dark:text-text-secondary-dark hover:text-text-primary dark:hover:text-text-primary-dark hover:bg-surface-hover dark:hover:bg-surface-hover-dark",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Right side: Theme toggle + mobile menu -->
      <div class="flex items-center gap-2">
        <!-- Theme Toggle -->
        <button
          id="theme-btn"
          aria-label="Toggle dark mode"
          class="p-2 rounded-card text-text-secondary dark:text-text-secondary-dark hover:text-text-primary dark:hover:text-text-primary-dark hover:bg-surface-hover dark:hover:bg-surface-hover-dark transition-colors"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg
            class="hidden dark:block w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg
            class="block dark:hidden w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          aria-label="Toggle menu"
          class="sm:hidden p-2 rounded-card text-text-secondary dark:text-text-secondary-dark hover:bg-surface-hover dark:hover:bg-surface-hover-dark transition-colors"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <nav
      id="mobile-menu"
      class="sm:hidden hidden pb-4 border-t border-border dark:border-border-dark mt-2 pt-2"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "block px-3 py-2 rounded-card text-sm font-medium transition-colors",
              currentPath === link.href ||
              (link.href !== "/" && currentPath.startsWith(link.href))
                ? "text-accent dark:text-accent-dark bg-surface-card dark:bg-surface-card-dark"
                : "text-text-secondary dark:text-text-secondary-dark hover:text-text-primary dark:hover:text-text-primary-dark",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // Theme toggle
  function setupTheme() {
    const btn = document.getElementById("theme-btn");
    btn?.addEventListener("click", () => {
      const html = document.documentElement;
      const isDark = html.classList.contains("dark");
      html.classList.remove("dark", "light");
      html.classList.add(isDark ? "light" : "dark");
      localStorage.setItem("theme", isDark ? "light" : "dark");
    });
  }

  // Mobile menu toggle
  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    btn?.addEventListener("click", () => {
      menu?.classList.toggle("hidden");
    });
  }

  setupTheme();
  setupMobileMenu();

  // Re-run on View Transitions navigation
  document.addEventListener("astro:after-swap", () => {
    setupTheme();
    setupMobileMenu();
  });
</script>

---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  sticky?: boolean;
}

const { headings, sticky = false } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

if (toc.length === 0) return null;
---

<div
  class:list={["hidden xl:block w-48", sticky ? "sticky top-20" : ""]}
>
  <nav
    id="toc"
    class="rounded-card border border-border dark:border-border-dark bg-surface-card/70 dark:bg-surface-card-dark/70 backdrop-blur-sm"
    aria-label="Table of Contents"
  >
    <div class="p-4">
      <div class="mb-3 flex items-center justify-between gap-2">
        <h3
          class="font-heading font-semibold text-[11px] uppercase tracking-[0.18em] text-text-muted dark:text-text-muted-dark"
        >
          On this page
        </h3>
        <span
          id="toc-progress-label"
          class="text-[11px] font-medium text-text-muted dark:text-text-muted-dark"
        >
          0%
        </span>
      </div>
      <div class="h-1 overflow-hidden rounded-full bg-border dark:bg-border-dark">
        <div
          id="toc-progress-bar"
          class="h-full w-0 rounded-full bg-accent dark:bg-accent-dark transition-[width] duration-150"
        ></div>
      </div>
    </div>

    <div class="max-h-[calc(100vh-12rem)] overflow-y-auto custom-scrollbar px-4 pb-4">
      <ul class="space-y-1 border-l-2 border-border dark:border-border-dark">
        {
          toc.map((heading) => (
            <li
              style={`padding-left: ${(heading.depth - 2) * 0.75 + 0.75}rem`}
              class="relative"
            >
              <a
                href={`#${heading.slug}`}
                data-toc-link
                class="block py-1 pr-1 text-[0.8125rem] text-text-secondary dark:text-text-secondary-dark hover:text-accent dark:hover:text-accent-dark transition-colors duration-150 leading-snug
                  aria-[current=true]:text-accent aria-[current=true]:dark:text-accent-dark aria-[current=true]:font-medium
                  before:absolute before:left-[-2px] before:top-0 before:bottom-0 before:w-0.5 before:bg-transparent before:transition-colors
                  aria-[current=true]:before:bg-accent aria-[current=true]:dark:before:bg-accent-dark"
              >
                {heading.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</div>

<script>
  function setupScrollspy() {
    const tocLinks = document.querySelectorAll("[data-toc-link]");
    if (tocLinks.length === 0) return;

    const progressBar = document.getElementById("toc-progress-bar");
    const progressLabel = document.getElementById("toc-progress-label");
    const headingElements = document.querySelectorAll("article :is(h2, h3)");
    if (headingElements.length === 0) return;

    if (window.__tocObserver) {
      window.__tocObserver.disconnect();
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((link) => {
              const href = link.getAttribute("href");
              if (href === `#${id}`) {
                link.setAttribute("aria-current", "true");
              } else {
                link.removeAttribute("aria-current");
              }
            });
          }
        }
      },
      {
        rootMargin: "-20% 0px -60% 0px",
        threshold: 0,
      }
    );

    window.__tocObserver = observer;

    headingElements.forEach((el) => observer.observe(el));

    const updateProgress = () => {
      const article = document.querySelector("article[data-pagefind-body]");
      if (!article || !progressBar || !progressLabel) return;

      const start = article.offsetTop;
      const end = start + article.scrollHeight - window.innerHeight + 80;
      const percent = Math.max(
        0,
        Math.min(100, Math.round(((window.scrollY - start) / Math.max(end - start, 1)) * 100))
      );

      progressBar.style.width = `${percent}%`;
      progressLabel.textContent = `${percent}%`;
    };

    updateProgress();
    window.removeEventListener("scroll", window.__tocProgressHandler);
    window.__tocProgressHandler = updateProgress;
    window.addEventListener("scroll", window.__tocProgressHandler, { passive: true });
  }

  setupScrollspy();
  document.addEventListener("astro:after-swap", setupScrollspy);
</script>

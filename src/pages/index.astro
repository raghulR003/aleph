---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HeroPost from "@/components/HeroPost.astro";
import PostCard from "@/components/PostCard.astro";
import SeriesCard from "@/components/SeriesCard.astro";
import { getCollection } from "astro:content";
import { 
  getSortedPosts, 
  getAllCategories, 
  getFeaturedSeries,
  getStandalonePosts,
  categoryMetadata 
} from "@/utils/posts";

const allPosts = await getCollection("blog");
const allSeries = await getCollection("series");
const sortedPosts = getSortedPosts(allPosts);
const [heroPost, ...restPosts] = sortedPosts;

// Get featured series
const featuredSeries = getFeaturedSeries(allSeries, allPosts);

// Get standalone posts (not in any series) for the latest posts section
const standalonePosts = getStandalonePosts(allPosts);

// Get categories with post counts
const categories = getAllCategories(allPosts);

// Category color classes
const categoryColors: Record<string, { bg: string; border: string; hover: string; text: string }> = {
  technical: {
    bg: "bg-blue-500/10 dark:bg-blue-400/10",
    border: "border-blue-200 dark:border-blue-800",
    hover: "hover:bg-blue-500/20 dark:hover:bg-blue-400/20",
    text: "text-blue-600 dark:text-blue-400",
  },
  creative: {
    bg: "bg-purple-500/10 dark:bg-purple-400/10",
    border: "border-purple-200 dark:border-purple-800",
    hover: "hover:bg-purple-500/20 dark:hover:bg-purple-400/20",
    text: "text-purple-600 dark:text-purple-400",
  },
  fiction: {
    bg: "bg-rose-500/10 dark:bg-rose-400/10",
    border: "border-rose-200 dark:border-rose-800",
    hover: "hover:bg-rose-500/20 dark:hover:bg-rose-400/20",
    text: "text-rose-600 dark:text-rose-400",
  },
  languages: {
    bg: "bg-emerald-500/10 dark:bg-emerald-400/10",
    border: "border-emerald-200 dark:border-emerald-800",
    hover: "hover:bg-emerald-500/20 dark:hover:bg-emerald-400/20",
    text: "text-emerald-600 dark:text-emerald-400",
  },
};
---

<BaseLayout title="aleph.">
  <Header />

  <main class="max-w-wide mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Categories Section */}
    <section class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-heading font-bold text-xl text-text-primary dark:text-text-primary-dark">
          Browse by Category
        </h2>
        <a
          href="/categories"
          class="text-sm font-medium text-accent dark:text-accent-dark hover:underline"
        >
          View all &rarr;
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[...categories.entries()].map(([category, count]) => {
          const meta = categoryMetadata[category];
          const colors = categoryColors[category];
          return (
            <a
              href={`/categories/${category}`}
              class={`group p-4 rounded-card border ${colors.border} ${colors.bg} ${colors.hover} transition-all duration-200`}
            >
              <h3 class={`font-heading font-semibold text-base ${colors.text} mb-1`}>
                {meta?.label || category}
              </h3>
              <p class="text-xs text-text-secondary dark:text-text-secondary-dark">
                {count} {count === 1 ? "post" : "posts"}
              </p>
            </a>
          );
        })}
      </div>
    </section>

    {/* Hero section */}
    {
      heroPost && (
        <section class="mb-12">
          <HeroPost
            title={heroPost.data.title}
            description={heroPost.data.description}
            pubDate={heroPost.data.pubDate}
            slug={heroPost.slug}
            coverImage={heroPost.data.coverImage}
            coverAlt={heroPost.data.coverAlt}
            tags={heroPost.data.tags}
            body={heroPost.body || ""}
          />
        </section>
      )
    }

    {/* Featured Series Section */}
    {
      featuredSeries.length > 0 && (
        <section class="mb-16">
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-heading font-bold text-2xl text-text-primary dark:text-text-primary-dark">
              Featured Series
            </h2>
            <a
              href="/categories"
              class="text-sm font-medium text-accent dark:text-accent-dark hover:underline"
            >
              All series &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {featuredSeries.map(({ series, postCount, posts }) => (
              <SeriesCard
                series={series}
                postCount={postCount}
                posts={posts}
              />
            ))}
          </div>
        </section>
      )
    }

    {/* Latest standalone posts grid */}
    {
      standalonePosts.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-8">
            <h2 class="font-heading font-bold text-2xl text-text-primary dark:text-text-primary-dark">
              Latest Posts
            </h2>
            <div class="flex items-center gap-4">
              <a
                href="/tags"
                class="text-sm font-medium text-text-secondary dark:text-text-secondary-dark hover:text-accent dark:hover:text-accent-dark transition-colors"
              >
                Tags
              </a>
              <a
                href="/search"
                class="text-sm font-medium text-accent dark:text-accent-dark hover:underline"
              >
                Search &rarr;
              </a>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {standalonePosts.slice(0, 6).map((post) => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={post.slug}
                coverImage={post.data.coverImage}
                coverAlt={post.data.coverAlt}
                tags={post.data.tags}
                body={post.body || ""}
              />
            ))}
          </div>
          {standalonePosts.length > 6 && (
            <div class="mt-8 text-center">
              <a
                href="/categories"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border dark:border-border-dark bg-surface-card dark:bg-surface-card-dark hover:bg-surface-hover dark:hover:bg-surface-hover-dark transition-colors text-sm font-medium text-text-primary dark:text-text-primary-dark"
              >
                View all {standalonePosts.length} posts
              </a>
            </div>
          )}
        </section>
      )
    }

    {/* Empty state */}
    {
      sortedPosts.length === 0 && (
        <section class="text-center py-20">
          <h2 class="font-heading font-bold text-2xl text-text-primary dark:text-text-primary-dark mb-4">
            No posts yet
          </h2>
          <p class="text-text-secondary dark:text-text-secondary-dark">
            Add your first post in{" "}
            <code class="px-2 py-1 rounded bg-surface-card dark:bg-surface-card-dark text-sm font-mono">
              src/content/blog/
            </code>
          </p>
        </section>
      )
    }
  </main>

  <Footer />
</BaseLayout>

---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="timeline-item relative pl-8 pb-8 last:pb-0">
  <div class="absolute left-0 top-1.5 h-3 w-3 rounded-full bg-accent dark:bg-accent-dark"></div>
  <div class="absolute left-[5px] top-5 bottom-0 w-px bg-border dark:bg-border-dark"></div>
  <div class="mb-1 text-sm font-semibold uppercase tracking-wide text-text-muted dark:text-text-muted-dark">
    {label}
  </div>
  <div class="text-text-secondary dark:text-text-secondary-dark leading-7">
    <slot />
  </div>
</div>

---
interface Props {
  question: string;
  open?: boolean;
}

const { question, open = false } = Astro.props;
---

<details class="my-6 rounded-card border border-border dark:border-border-dark bg-surface-card dark:bg-surface-card-dark px-5 py-4" open={open}>
  <summary class="cursor-pointer list-none font-heading text-lg font-semibold text-text-primary dark:text-text-primary-dark">
    {question}
  </summary>
  <div class="mt-4 text-text-secondary dark:text-text-secondary-dark leading-7">
    <slot />
  </div>
</details>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostCard from "@/components/PostCard.astro";
import SeriesCard from "@/components/SeriesCard.astro";
import { getCollection } from "astro:content";
import { 
  getPostsByCategory, 
  getAllCategories, 
  getSeriesByCategory,
  getStandalonePostsByCategory,
  categoryMetadata 
} from "@/utils/posts";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const categories = getAllCategories(allPosts);

  return [...categories.keys()].map((category) => ({
    params: { category: category.toLowerCase() },
    props: { category },
  }));
}

const { category } = Astro.props;
const allPosts = await getCollection("blog");
const allSeries = await getCollection("series");

// Get series and standalone posts separately
const categorySeries = getSeriesByCategory(category, allSeries, allPosts);
const standalonePosts = getStandalonePostsByCategory(category, allPosts);
const meta = categoryMetadata[category];

// Calculate total content count
const totalPosts = categorySeries.reduce((sum, s) => sum + s.postCount, 0) + standalonePosts.length;

// Category color mapping for header accent
const categoryColors: Record<string, string> = {
  technical: "text-blue-600 dark:text-blue-400",
  creative: "text-purple-600 dark:text-purple-400",
  fiction: "text-rose-600 dark:text-rose-400",
  languages: "text-emerald-600 dark:text-emerald-400",
};
const accentColor = categoryColors[category] || "text-accent dark:text-accent-dark";
---

<BaseLayout title={`${meta?.label || category} | aleph.`}>
  <Header />

  <main class="max-w-wide mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-12">
      <a
        href="/categories"
        class="inline-flex items-center gap-1 text-sm text-text-secondary dark:text-text-secondary-dark hover:text-accent dark:hover:text-accent-dark transition-colors mb-4"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
          <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
        </svg>
        All categories
      </a>
      <h1 class={`font-heading font-extrabold text-4xl ${accentColor} mb-2`}>
        {meta?.label || category}
      </h1>
      {meta?.description && (
        <p class="text-lg text-text-secondary dark:text-text-secondary-dark max-w-2xl">
          {meta.description}
        </p>
      )}
      <p class="text-sm text-text-tertiary dark:text-text-tertiary-dark mt-2">
        {totalPosts} {totalPosts === 1 ? "post" : "posts"}
        {categorySeries.length > 0 && (
          <span> · {categorySeries.length} {categorySeries.length === 1 ? "series" : "series"}</span>
        )}
      </p>
    </header>

    {/* Series Section */}
    {categorySeries.length > 0 && (
      <section class="mb-16">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-text-primary dark:text-text-primary-dark">
            Series
          </h2>
          <span class="text-sm text-text-secondary dark:text-text-secondary-dark">
            Multi-part content
          </span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {categorySeries.map(({ series, postCount, posts }) => (
            <SeriesCard
              series={series}
              postCount={postCount}
              posts={posts}
            />
          ))}
        </div>
      </section>
    )}

    {/* Standalone Posts Section */}
    {standalonePosts.length > 0 && (
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-text-primary dark:text-text-primary-dark">
            Standalone Posts
          </h2>
          <span class="text-sm text-text-secondary dark:text-text-secondary-dark">
            Individual articles
          </span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {standalonePosts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.slug}
              coverImage={post.data.coverImage}
              coverAlt={post.data.coverAlt}
              tags={post.data.tags}
              body={post.body || ""}
            />
          ))}
        </div>
      </section>
    )}

    {/* Empty State */}
    {categorySeries.length === 0 && standalonePosts.length === 0 && (
      <div class="text-center py-16">
        <p class="text-text-secondary dark:text-text-secondary-dark">
          No posts in this category yet.
        </p>
        <a
          href="/categories"
          class="inline-flex items-center gap-1 text-accent dark:text-accent-dark hover:underline mt-4"
        >
          Browse other categories
        </a>
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>

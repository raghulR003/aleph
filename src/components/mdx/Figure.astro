---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-10">
  <img
    src={src}
    alt={alt}
    loading="lazy"
    class="w-full rounded-card border border-border dark:border-border-dark"
  />
  {
    caption && (
      <figcaption class="mt-3 text-center text-sm text-text-secondary dark:text-text-secondary-dark">
        {caption}
      </figcaption>
    )
  }
</figure>

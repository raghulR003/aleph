---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string;
}

const { currentPage, totalPages, basePath = "" } = Astro.props;

if (totalPages <= 1) return null;

const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
const getPageUrl = (page: number) =>
  page === 1 ? basePath || "/" : `${basePath}/page/${page}`;
---

<nav aria-label="Pagination" class="flex items-center justify-center gap-2 mt-12">
  {
    currentPage > 1 && (
      <a
        href={getPageUrl(currentPage - 1)}
        class="px-3 py-2 text-sm font-medium rounded-card text-text-secondary dark:text-text-secondary-dark hover:bg-surface-hover dark:hover:bg-surface-hover-dark transition-colors"
        aria-label="Previous page"
      >
        &larr; Previous
      </a>
    )
  }

  {
    pages.map((page) => (
      <a
        href={getPageUrl(page)}
        class:list={[
          "w-10 h-10 flex items-center justify-center text-sm font-medium rounded-card transition-colors",
          page === currentPage
            ? "bg-accent dark:bg-accent-dark text-white"
            : "text-text-secondary dark:text-text-secondary-dark hover:bg-surface-hover dark:hover:bg-surface-hover-dark",
        ]}
        aria-current={page === currentPage ? "page" : undefined}
      >
        {page}
      </a>
    ))
  }

  {
    currentPage < totalPages && (
      <a
        href={getPageUrl(currentPage + 1)}
        class="px-3 py-2 text-sm font-medium rounded-card text-text-secondary dark:text-text-secondary-dark hover:bg-surface-hover dark:hover:bg-surface-hover-dark transition-colors"
        aria-label="Next page"
      >
        Next &rarr;
      </a>
    )
  }
</nav>
